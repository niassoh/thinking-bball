# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Google service-account key: local file here, a secret in CI (nightly.yml writes it)
privatekey.json

# next.js build output
.next

# Raw source snapshots downloaded by scripts/build-bio.js (re-fetchable)
data/sources/
# Per-game ESPN play-by-play cache for scripts/shotshift.js (re-fetchable)
data/cache/
# Portrait source photos: re-downloadable via scripts/portraits/selections.sh
assets/player-sources/*.jpg
assets/player-sources/*.jpeg
assets/player-sources/*.png
assets/player-sources/*.webp
# Portrait PNG masters, attempts and review sheets stay local (large); the
# 1024/400/200/100 WebPs and metadata in assets/players/ are committed.
assets/players/*.png
assets/players/attempts/
.DS_Store

# Analysis virtualenv (analysis/footprint/requirements.txt)
analysis/footprint/.venv/
__pycache__/
